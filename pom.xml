<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-mesh-pipelines-jvstype</artifactId>
    <version>3.0.1</version>
    <packaging>jar</packaging>

    <name>hitorro-mesh-pipelines-jvstype</name>
    <description>
        Bridges hitorro-mesh-pipelines to the full JVS type system in
        hitorro-jsontypesystem. Contributes a real jvs-groovy step
        implementation via the StepAdapter SPI — dropping this jar on the
        classpath enables the shipped GroovyTransformMapper DSL
        (source/target/work registers, copyAll/copy/set/mls/append/times/
        loop/when, gen.* generators) as a pipeline step.

        Heavy dep tail — pulls hitorro-jsontypesystem which transitively
        drags OpenNLP + tokenizers. Opt in only when you need full JVS
        semantics; the lean pipelines-core has ToTyped + GroovyMap for
        most needs.
    </description>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-pipelines</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-jsontypesystem</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <!-- Skip the heaviest transitive weight so the adapter
                     jar itself stays lean. Users who need NLP wire
                     hitorro-jsontypesystem directly. -->
                <exclusion>
                    <groupId>org.apache.opennlp</groupId>
                    <artifactId>opennlp-dl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ai.djl.huggingface</groupId>
                    <artifactId>tokenizers</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Full IndexManager + JVSLuceneIndexWriter for the jvs-lucene sink.
             Type-aware Lucene projection: identifier → StringField, text →
             analyzed TextField, mls → per-language TextField, long → LongPoint.
             Same jar the fleet-retrieval service uses to read back. -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-index</artifactId>
            <version>3.0.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
    </distributionManagement>
</project>
